{
  "include": ["src", "tests"],
  "extraPaths": ["."],
  "exclude": [
    "**/__pycache__",
    "external",
    "output",
    "wandb",
    "tests/*",
    "scripts/*"
  ],
  "typeCheckingMode": "standard",
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "none",
  "reportPrivateImportUsage": "none"
}
