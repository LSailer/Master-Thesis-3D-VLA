{
  "include": ["src", "tests"],
  "extraPaths": ["."],
  "exclude": [
    "**/__pycache__",
    "external",
    "output",
    "wandb",
    "tests/r2dreamer",
    "tests/r2dreamer/launch"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "none",
  "reportPrivateImportUsage": "none"
}
