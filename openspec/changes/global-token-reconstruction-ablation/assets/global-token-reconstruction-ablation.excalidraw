      "seed": 1363736523,
      "version": 151,
      "versionNonce": 965980295,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784007488496,
      "link": null,
      "locked": false,
      "text": "1.  patch tokens                         (1369, 1024)\n2.  shared per-token MLP:  Dense → RMSNorm → SiLU\n        (same weights for every token, no interaction)\n3.  MAX-POOL over the 1369 tokens   →  (1024)\n        → permutation-invariant (order doesn't matter)\n4.  Dense(1024) projection            →  (1, 1024)",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.  patch tokens                         (1369, 1024)\n2.  shared per-token MLP:  Dense → RMSNorm → SiLU\n        (same weights for every token, no interaction)\n3.  MAX-POOL over the 1369 tokens   →  (1024)\n        → permutation-invariant (order doesn't matter)\n4.  Dense(1024) projection            →  (1, 1024)",
      "lineHeight": 1.25,
      "index": "b03",
      "autoResize": true
    },
