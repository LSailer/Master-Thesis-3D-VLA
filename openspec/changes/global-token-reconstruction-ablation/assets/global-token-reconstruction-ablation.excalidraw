    {
      "id": "Gl90_N_E7kAcF_yp9ykQ-",
      "type": "text",
      "x": -549.9888392857143,
      "y": 436.2126116071429,
      "width": 460,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
