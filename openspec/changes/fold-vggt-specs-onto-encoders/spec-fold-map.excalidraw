    {
      "id": "t_note",
      "type": "text",
      "x": 40,
      "y": 1570,
      "width": 939.4000000000001,
      "height": 54.599999999999994,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 12700381,
      "version": 2,
      "versionNonce": 1356515572,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784099608831,
      "link": null,
      "locked": false,
      "text": "Same readout, opposite storage — twice. ⇒ storage must stay a DECLARED field on the Encoder, never derived from readout.\nOwnership, not derivation, is the reason it moves: storage is per-variant data, and the variant IS the Encoder class.\nPin these four rows with a regression test so a future \"simplify\" pass cannot quietly re-derive it. (design.md Decision 4)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same readout, opposite storage — twice. ⇒ storage must stay a DECLARED field on the Encoder, never derived from readout.\nOwnership, not derivation, is the reason it moves: storage is per-variant data, and the variant IS the Encoder class.\nPin these four rows with a regression test so a future \"simplify\" pass cannot quietly re-derive it. (design.md Decision 4)",
      "lineHeight": 1.25,
      "index": "b01",
      "autoResize": true
    },
    {
      "id": "t_note2",
      "type": "text",
      "x": 40,
      "y": 1646,
      "width": 858.0000000000001,
      "height": 33.800000000000004,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 12900387,
      "version": 2,
      "versionNonce": 1439264844,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784099608831,
      "link": null,
      "locked": false,
      "text": "\"replay is not launch\" doesn't survive contact: agent_overrides already carries buffer_capacity (1_000_000) and\n_SMALL_REPLAY_OVERRIDES already carries batch_size / seq_len / train_ratio. Replay concerns live on the selection today.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"replay is not launch\" doesn't survive contact: agent_overrides already carries buffer_capacity (1_000_000) and\n_SMALL_REPLAY_OVERRIDES already carries batch_size / seq_len / train_ratio. Replay concerns live on the selection today.",
      "lineHeight": 1.25,
      "index": "b02",
      "autoResize": true
    },
