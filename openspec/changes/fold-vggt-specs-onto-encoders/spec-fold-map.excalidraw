    {
      "id": "dead_b",
      "type": "text",
      "x": 58,
      "y": 1194,
      "width": 507.65000000000003,
      "height": 169.00000000000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
