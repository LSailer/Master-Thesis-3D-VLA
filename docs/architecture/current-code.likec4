specification {
  element actor {
    style {
      shape person
    }
  }

  element boundary {
    style {
      shape rectangle
    }
  }

  element script {
    style {
      shape rectangle
    }
  }

  element config {
    style {
      shape rectangle
    }
  }

  element model {
    style {
      shape rectangle
    }
  }

  element module {
    style {
      shape rectangle
    }
  }

  element tensor {
    style {
      shape rectangle
    }
  }

  element buffer {
    style {
      shape storage
    }
  }

  element cache {
    style {
      shape storage
    }
  }

  element store {
    style {
      shape storage
    }
  }
}

model {
  researcher = actor 'Researcher / operator' {
    technology 'CLI, SLURM, W&B'
    description '
      Starts training, evaluation, profiling, and analysis runs.
      The current code is organized around script-level run selection, launcher registries, and a JAX/Flax R2Dreamer agent.
    '
  }

  codebase = boundary 'Master-Thesis-3D-VLA current code' {
    technology 'Python, JAX/Flax, Habitat, VGGT'
    description '
      Current main-branch architecture for ObjectNav experiments.
      The source contracts are the root and scoped AGENTS.md files plus the current src/ and scripts/ modules.
    '

    orchestration = boundary 'Experiment orchestration' {
      technology 'scripts/r2dreamer, scripts/slurm'
      run_dispatcher = script 'scripts/r2dreamer/run.py' {
        technology 'Single run-id dispatcher'
        description 'Accepts run.py <run-id> [train flags] and forwards to _run_configs.launch_run.'
      }

      run_configs = config 'RUN_CONFIGS' {
        technology 'scripts/r2dreamer/_run_configs.py'
        description '
          Single source of truth for env, encoder, curriculum, output_dir, wandb_name, and wandb_tags.
          Known run ids cover Habitat L1-L4 CNN/VGGT variants and Crafter CNN.
        '
      }

      slurm_configs = config 'SLURM configs' {
        technology 'scripts/slurm/configs/*.yaml and legacy *.sbatch'
        description 'Render or call run.py with a run_id and train flags. GPU work is launched through the cluster scheduler.'
      }

      public_entrypoint = script 'src/main.py' {
        technology 'train, evaluate, parity commands'
        description 'Public CLI dispatcher for train/evaluate and parity workflows.'
      }

      train_entry = script 'src.r2dreamer.launch.train.train' {
        technology 'Launcher composition root'
        description '
          Resolves curriculum, encoder, env, agent config, trainer config, agent, and Trainer.
          Runs Trainer.run() and returns the Trainer for programmatic callers.
        '
      }

      registries = config 'launch registries' {
        technology 'src/r2dreamer/launch/registries.py'
        description 'Maps encoder strings to Encoder classes and env strings to env factories.'
      }

      curriculum = store 'Curriculum JSON' {
        technology 'data/curriculum/*.json'
        description 'Habitat L1-L4 curriculum files resolved by launch/curricula.py and _helpers.py.'
      }

      run_dispatcher -> run_configs 'select run id'
      slurm_configs -> run_dispatcher 'render or call'
      run_configs -> public_entrypoint 'call src.main.train'
      public_entrypoint -> train_entry 'dispatch train'
      train_entry -> registries 'resolve env and encoder'
      train_entry -> curriculum 'resolve Habitat curriculum'
    }

    environment = boundary 'Environment layer' {
      technology 'src/environments, Habitat/Crafter'
      habitat_factory = model 'make_habitat_env' {
        technology 'src/r2dreamer/launch/habitat_setup.py'
        description 'Builds HabitatObjectNavEnv with curriculum mode, seed, and render resolution from EncoderSpec.'
      }

      crafter_factory = model 'make_crafter_env' {
        technology 'src/r2dreamer/launch/registries.py'
        description 'Thin CrafterEnv factory with fixed 64x64 observations and 17 actions.'
      }

      habitat_env = model 'HabitatObjectNavEnv' {
        technology 'src/environments/habitat*.py'
        description 'ObjectNav environment emitting image observations and episode metrics such as success, SPL, softSPL, distance-to-goal, and collision rate.'
      }

      crafter_env = model 'CrafterEnv' {
        technology 'src/environments/crafter.py'
        description 'Non-curriculum sanity environment used by the crafter-cnn run.'
      }

      rgb64 = tensor 'RGB observation: 3 x 64 x 64' {
        technology 'uint8 CHW'
        description 'Default CNN observation shape. obs_batch normalizes it to float32 [0, 1] at the agent boundary.'
      }

      rgb518 = tensor 'VGGT RGB observation: 3 x 518 x 518' {
        technology 'uint8 CHW'
        description 'VGGT variants request 518x518 render resolution so the fixed 37x37 patch grid matches the StreamVGGT/JAXVGGT backbone.'
      }

      habitat_factory -> habitat_env 'instantiate train and optional val env'
      crafter_factory -> crafter_env 'instantiate'
      habitat_env -> rgb64 'CNN render path'
      habitat_env -> rgb518 'VGGT render path'
      crafter_env -> rgb64 'Crafter render path'
    }

    encoder_boundary = boundary 'Encoder and adapter layer' {
      technology 'src/r2dreamer/encoders and adapters'
      encoder_spec = config 'EncoderSpec' {
        technology 'obs_shape, env_render_resolution, encoder_type, module_cls'
        description '
          Launcher-side contract that keeps adapter output, environment render size, and the Flax encoder module aligned.
          train.py copies the spec into R2DreamerConfig.
        '
      }

      obs_adapter = model 'ObsAdapter' {
        technology 'src/r2dreamer/adapters/obs_adapter.py'
        description 'Default RGB passthrough adapter with buffer shape (3,64,64), dtype uint8, and normalize_on_sample=True.'
      }

      vggt_adapter = model 'VGGTObsAdapter' {
        technology 'src/r2dreamer/adapters/vggt_adapter.py'
        description '
          Runs JAXVGGTFeatureExtractor per frame and returns replay features plus one-step agent features.
          Feature kinds: wp_cp, aggregator, wp_dense, agg_raw.
        '
      }

      hybrid_adapter = model 'HybridObsAdapter' {
        technology 'src/r2dreamer/adapters/hybrid_adapter.py'
        description '
          Runs VGGT for WP/CP, resizes the same 518x518 frame to 64x64 RGB, and stores explicit replay fields image and wp_cp.
        '
      }

      cnn_spec = config 'cnn' {
        technology 'ConvEncoder, obs_shape (3,64,64)'
      }

      wp_cp_spec = config 'vggt / vggt_wp_cp_64' {
        technology 'VGGTEncoder MLP'
        description 'WP/CP vector is K*K*3 world points plus 9 camera-pose values. K=37 gives 4116; K=64 gives 12297.'
      }

      aggregator_spec = config 'vggt_aggregator_mlp' {
        technology 'VGGTAggregatorMLPEncoder'
        description 'Pools VGGT global aggregator tokens into [camera | mean_patches | max_patches] = 3072 float32 values.'
      }

      dense_wp_spec = config 'vggt_wp_dense_cnn' {
        technology 'WPConvEncoder'
        description 'Stores dense world points as (3,518,518) float16 and encodes them with a symlog conv stack.'
      }

      hybrid_spec = config 'hybrid' {
        technology 'HybridEncoder'
        description 'Stores image uint8 (3,64,64) and WP/CP float32 separately, then packs to 16404 features at the JAX boundary.'
      }

      wp_cp = tensor 'WP/CP features' {
        technology '4116 or 12297 float32'
      }

      pooled_agg = tensor 'Pooled aggregator features' {
        technology '3072 float32'
      }

      dense_wp = tensor 'Dense world-point map' {
        technology '3 x 518 x 518 float16'
      }

      hybrid_obs = tensor 'Hybrid replay observation' {
        technology 'image uint8 + wp_cp float32'
        description 'Replay keeps modalities inspectable under explicit keys; obs_batch packs them into the legacy flat tensor.'
      }

      encoder_spec -> obs_adapter 'default RGB adapter'
      encoder_spec -> vggt_adapter 'VGGT standalone variants'
      encoder_spec -> hybrid_adapter 'hybrid variant'
      obs_adapter -> cnn_spec 'declares'
      vggt_adapter -> wp_cp_spec 'wp_cp readout'
      vggt_adapter -> aggregator_spec 'aggregator readout'
      vggt_adapter -> dense_wp_spec 'dense WP readout'
      hybrid_adapter -> hybrid_spec 'hybrid readout'
      vggt_adapter -> wp_cp 'extract world_points + camera_pose'
      vggt_adapter -> pooled_agg 'pool final global tokens'
      vggt_adapter -> dense_wp 'request return_dense'
      hybrid_adapter -> hybrid_obs 'store two fields'
    }

    training_loop = boundary 'Trainer and replay loop' {
      technology 'src/r2dreamer/trainer.py, src/buffer/replay_buffer.py'
      trainer = model 'Trainer' {
        technology 'Prefill, collect, train_ratio, val, log, checkpoint'
        description '
          Owns environment stepping, replay insertion, batch sampling, validation env loop, metrics, W&B logging, videos, checkpoints, and MANIFEST writes.
        '
      }

      replay = buffer 'ReplayBuffer' {
        technology 'NumPy ring buffer'
        description '
          Stores observations as one array or a mapping of named fields.
          Samples fixed length (B,T) windows and returns JAX arrays with is_first, actions, rewards, dones, and terminals.
        '
      }

      sampled_batch = tensor 'Sampled sequence batch' {
        technology 'obs + actions + rewards + dones + terminals + is_first'
        description 'Replay sample window consumed by convert_batch and agent.train_step.'
      }

      convert_batch = model 'convert_batch' {
        technology 'trainer.py'
        description 'One-hot encodes actions to (B,T,A), maps dones to is_last, terminals to is_terminal, and preserves is_first.'
      }

      obs_batch = model 'obs_batch bridge' {
        technology 'src/r2dreamer/obs_batch.py'
        description '
          Normalizes CNN RGB, casts VGGT features to float32, packs hybrid dict observations, and reshapes observations to B*T before the Flax encoder.
        '
      }

      metrics = store 'Run artifacts' {
        technology 'output/runs, metrics.csv, checkpoints, MANIFEST.json, W&B'
        description 'Trainer writes local checkpoints and metrics, manifest provenance, optional videos, and W&B summaries.'
      }

      trainer -> replay 'add transition'
      replay -> sampled_batch 'sample (B,T)'
      sampled_batch -> convert_batch 'format batch'
      convert_batch -> obs_batch 'agent boundary'
      trainer -> metrics 'log and save'
    }

    agent_boundary = boundary 'R2Dreamer agent' {
      technology 'src/r2dreamer/agent.py'
      agent = model 'R2DreamerAgent' {
        technology 'JAX/Flax composition root'
        description '
          Owns params, optimizer state, slow critic EMA, acting state, JIT-compiled train_step and act.
          A single shared forward pass feeds world-model, behavior, and representation losses under one jax.grad.
        '
      }

      config = config 'R2DreamerConfig' {
        technology 'src/r2dreamer/config.py'
        description '
          Config-first source of truth for RSSM sizes, encoder choice, loss scales, batch/sequence settings, train_ratio, replay capacity, optimizer, and run defaults.
        '
      }

      encoder_mod = module 'Flax observation encoder' {
        technology 'ConvEncoder, VGGTEncoder, VGGTAggregatorMLPEncoder, WPConvEncoder, HybridEncoder'
        description 'Chosen by EncoderSpec.module_cls and instantiated inside the agent, on the JAX side of the boundary.'
      }

      embed = tensor 'Observation embed' {
        technology 'usually 1024 or hybrid 2048'
        description 'Encoder output that conditions the RSSM posterior.'
      }

      rssm = module 'R2RSSM' {
        technology 'src/r2dreamer/world_model/rssm.py'
        description 'Block-GRU latent dynamics with observe, img_step, and get_feat.'
      }

      rssm_feat = tensor 'RSSM feature' {
        technology 'deter_size + stoch_classes*stoch_discrete'
        description 'Default feature size is 2048 deterministic + 512 stochastic = 2560.'
      }

      heads = boundary 'Prediction and control heads' {
        technology 'src/r2dreamer/world_model/heads.py'
        reward = module 'Reward head' {
          technology 'R2MLP + two-hot'
        }
        cont = module 'Continue head' {
          technology 'R2MLP sigmoid'
        }
        actor = module 'Actor head' {
          technology 'R2MLP action logits'
        }
        critic = module 'Critic head' {
          technology 'R2MLP + two-hot'
        }
        decoder = module 'Optional RGB decoder' {
          technology 'ConvDecoder, cfg.decoder'
        }
      }

      losses = boundary 'Loss composition' {
        technology 'world_model, behavior, representation'
        wm_loss = model 'world_model_loss' {
          technology 'KL dyn/rep + reward + continue + optional decoder'
        }
        behavior_loss = model 'behavior_loss' {
          technology 'Detached imagination, lambda-return, actor and critic losses'
        }
        rep_loss = model 'representation_loss' {
          technology 'Barlow Twins + replay-value'
        }
        optimizer = model 'LaProp + AGC update' {
          technology 'src/shared/optim.py'
          description 'Weighted total loss is differentiated once and updates the single params pytree.'
        }
      }

      config -> agent 'initialize'
      obs_batch -> encoder_mod 'B*T observations'
      encoder_mod -> embed 'encode obs'
      embed -> rssm 'posterior observe'
      rssm -> rssm_feat 'post states and feat'
      rssm_feat -> heads.reward 'predict reward'
      rssm_feat -> heads.cont 'predict continuation'
      rssm_feat -> heads.actor 'act and imagine'
      rssm_feat -> heads.critic 'value'
      rssm_feat -> heads.decoder 'optional reconstruction'
      rssm_feat -> losses.wm_loss 'world-model terms'
      rssm_feat -> losses.behavior_loss 'imagination starts'
      rssm_feat -> losses.rep_loss 'representation terms'
      losses.wm_loss -> losses.optimizer 'weighted sum'
      losses.behavior_loss -> losses.optimizer 'weighted sum'
      losses.rep_loss -> losses.optimizer 'weighted sum'
      losses.optimizer -> agent 'update params and optimizer state'
    }

    vggt_boundary = boundary 'VGGT production encoder' {
      technology 'src/vggt/jax'
      extractor = model 'JAXVGGTFeatureExtractor' {
        technology 'src/vggt/jax/feature_extractor.py'
        description '
          Drop-in JAX backend for StreamVGGT.
          Loads HuggingFace StreamVGGT weights, keeps streaming caches as instance state, resets at episode boundaries, and exposes extract(rgb).
        '
      }

      aggregator = module 'Aggregator' {
        technology '24 alternating attention blocks'
        description 'Consumes fixed 518x518 RGB, emits camera + register + patch tokens, and supports streaming cache paths.'
      }

      agg_cache = cache 'Aggregator padded KV cache' {
        technology 'per-block (k_pad, v_pad, valid_len)'
        description 'Fixed-shape padded cache keeps JIT stable. Per-block budgets are Python static args; eviction uses budgeted cache control.'
      }

      camera_cache = cache 'Camera-head padded KV cache' {
        technology 'max_camera_frames guard'
        description 'Camera head cache fails loudly on overflow instead of silently clamping dynamic updates.'
      }

      camera_head = module 'CameraHead' {
        technology 'pose output'
      }

      point_head = module 'DPTHead' {
        technology 'dense 518 x 518 x 3 points'
      }

      aggregator_tokens = tensor 'Aggregator features' {
        technology '1374 x 1024 global stream'
        description 'Final global-stream tokens: 1 camera + 4 registers + 37x37 patches, 1024 dims. Pooled variants drop registers when flattening raw or pooling patches.'
      }

      world_points = tensor 'world_points' {
        technology 'K x K x 3'
        description 'Dense point map pooled to K=37 by default or K=64 for vggt_wp_cp_64.'
      }

      camera_pose = tensor 'camera_pose' {
        technology '9 float32 values'
      }

      dense_world_points = tensor 'dense_world_points' {
        technology '518 x 518 x 3 float32'
      }

      extractor -> aggregator 'run one frame'
      aggregator -> agg_cache 'read and update'
      aggregator -> aggregator_tokens 'expose final global stream'
      aggregator -> camera_head 'if compute_heads=True'
      aggregator -> point_head 'if compute_heads=True'
      camera_head -> camera_cache 'read and update'
      camera_head -> camera_pose 'pose'
      point_head -> dense_world_points 'dense points'
      dense_world_points -> world_points 'pool to K x K'
    }

    evaluation = boundary 'Evaluation and parity workflows' {
      technology 'src/r2dreamer/launch/evaluate.py, launch/parity'
      evaluate = script 'evaluate()' {
        technology 'checkpoint evaluation'
        description 'Loads a policy checkpoint, constructs the matching env and encoder, runs episodes, and logs metrics.'
      }

      parity = script 'parity workflows' {
        technology 'train_parity.py, benchmark.py'
        description 'JAX/PyTorch parity training and benchmark commands for debugging numerical drift.'
      }

      checkpoints = store 'Policy checkpoints' {
        technology 'pickle step_*.pkl'
        description 'Contain params, opt_state, slow_critic_params, ema_state, and step.'
      }

      evaluate -> checkpoints 'load'
      parity -> agent_boundary.agent 'compare behavior'
    }

    orchestration.train_entry -> environment.habitat_factory 'for habitat'
    orchestration.train_entry -> environment.crafter_factory 'for crafter'
    orchestration.registries -> encoder_boundary.encoder_spec 'resolve encoder'
    environment.rgb64 -> encoder_boundary.obs_adapter 'CNN path'
    environment.rgb518 -> encoder_boundary.vggt_adapter 'VGGT standalone path'
    environment.rgb518 -> encoder_boundary.hybrid_adapter 'hybrid path'
    encoder_boundary.obs_adapter -> training_loop.trainer 'obs adapter'
    encoder_boundary.vggt_adapter -> training_loop.trainer 'obs adapter'
    encoder_boundary.hybrid_adapter -> training_loop.trainer 'obs adapter'
    encoder_boundary.encoder_spec -> agent_boundary.config 'agent overrides and module_cls'
    training_loop.trainer -> agent_boundary.agent 'act and train_step'
    agent_boundary.agent -> training_loop.trainer 'action and metrics'
    vggt_boundary.extractor -> encoder_boundary.vggt_adapter 'extract features'
    vggt_boundary.extractor -> encoder_boundary.hybrid_adapter 'extract WP/CP'
    agent_boundary.agent -> evaluation.checkpoints 'save'
    evaluation.checkpoints -> evaluation.evaluate 'restore'
  }

  researcher -> codebase.orchestration.run_dispatcher 'starts run'
  researcher -> codebase.evaluation.evaluate 'runs evaluation'
}

views {
  view index {
    title 'Current Code Architecture'
    include *
  }

  view of codebase {
    title 'Current Code Overview'
    include *
  }

  view of codebase.orchestration {
    title 'Experiment Orchestration'
    include *
  }

  view of codebase.encoder_boundary {
    title 'Encoder Specs And Adapters'
    include *
  }

  view of codebase.training_loop {
    title 'Trainer Replay Loop'
    include *
  }

  view of codebase.agent_boundary {
    title 'R2Dreamer Agent Internals'
    include *
  }

  view of codebase.agent_boundary.losses {
    title 'Loss Composition'
    include *
  }

  view of codebase.vggt_boundary {
    title 'VGGT Streaming Encoder'
    include *
  }

  view of codebase.evaluation {
    title 'Evaluation And Parity'
    include *
  }
}
